<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      情報保護方針(docs/SECURITY.md):
      READ_CALL_LOG / WRITE_CALL_LOG / READ_SMS / SEND_SMS / CALL_PHONE /
      READ_PHONE_STATE / RECORD_AUDIO は宣言しない。
      POST_NOTIFICATIONS は Phase 2(通話スクリーニング通知)でのみ利用直前に要求する。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ACTION_DIAL / ACTION_SENDTO の解決可否を確認するため (API 30+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application
        android:name=".StoreCtiApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.StoreCti"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 通知・ショートカットからのディープリンク -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="storecti" />
            </intent-filter>
            <!-- 共有メニューから電話番号テキストを受け取る(経路C) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          Phase 2(実験機能): 通話スクリーニング。
          設定画面でユーザーが明示的に有効化し ROLE_CALL_SCREENING を許可した
          場合のみシステムからバインドされる。着信のブロックは行わない。
        -->
        <service
            android:name=".telephony.StoreCtiCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
    </application>
</manifest>
